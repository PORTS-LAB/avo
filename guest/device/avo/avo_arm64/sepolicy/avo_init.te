# avo_init: reads the host's BootConfig disk and applies it at boot.
type avo_init, domain, coredomain;
type avo_init_exec, system_file_type, exec_type, file_type;
init_daemon_domain(avo_init)

# /dev/block/by-name/avo_config
allow avo_init block_device:dir search;
allow avo_init avo_config_block_device:blk_file r_file_perms;

# Authorize the host's ADB key (/data/misc/adb/adb_keys).
allow avo_init adb_keys_file:dir rw_dir_perms;
allow avo_init adb_keys_file:file create_file_perms;

# Locale and time zone on first boot.
set_prop(avo_init, system_prop)
set_prop(avo_init, avo_boot_prop)
