<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Registered by Avo.app with SMAppService.agent(plistName:). The label and
     Mach service follow AvoIdentifiers (AvoKit); keep them in sync. -->
<dict>
	<key>Label</key>
	<string>dev.avo.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/Library/Helpers/AvoDaemon.app/Contents/MacOS/AvoDaemon</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.avo.Avo</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>dev.avo.daemon</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
